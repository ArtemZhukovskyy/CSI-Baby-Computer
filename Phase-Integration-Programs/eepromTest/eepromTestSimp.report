     9                           
    10                          !cpu w65c02 ;   Declare CPU type
    11                          * = $8000   ;   Set origin to addr. 8000
    12                           
    13                          reset: 
    14  8000 4c0080                 JMP reset
    15                              
    16                          ; Pad the ROM and place the interrupt/reset vectors.
    17  8003 eaeaeaeaeaeaeaea...!fill $fffa - *, $ea    ;   pad w/ NOPs
    18  fffa 0080               !word reset             ;   IRQ/BRK vector
    19  fffc 0080               !word reset             ;
    20  fffe 0080               !word reset             ;

